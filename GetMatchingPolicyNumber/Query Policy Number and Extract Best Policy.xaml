          <ui:InvokeCode ContinueOnError="{x:Null}" Code="' === Policy Number Best Match ===&#xA;' Inputs (Data Manager):&#xA;'   in_PolicyNumber  As String&#xA;'   policyList    As System.Collections.Generic.List(Of String)&#xA;' Outputs (Data Manager):&#xA;'   out_MatchType      As Int32   ' 1 = exact, 2 = contains, 0 = none&#xA;'   out_AppropriatePolicyNumber      As String&#xA;&#xA;'This code finds the best matching policy from a list of policies based on a given policy number. &#xA;'It normalizes the input strings by removing non-alphanumeric characters and converting to uppercase, then applies matching rules to determine the best match. &#xA;'The matching rules prioritize exact matches, followed by &quot;contains&quot; matches with certain length constraints to avoid overly broad matches. &#xA;'The outputs indicate whether a match was found, the type of match, the best matching policy, and its index in the list.&#xA;&#xA;Dim Normalize As System.Func(Of String, String) =&#xA;    Function(s As String) As String&#xA;        If String.IsNullOrWhiteSpace(s) Then Return String.Empty&#xA;        Dim alnum As String = System.Text.RegularExpressions.Regex.Replace(s, &quot;[^A-Za-z0-9]&quot;, &quot;&quot;)&#xA;        Return alnum.ToUpperInvariant()&#xA;    End Function&#xA;&#xA;Dim GetMatchType As System.Func(Of String, String, Integer) =&#xA;    Function(policy As String, policies As String) As Integer&#xA;        Dim pnA As String = Normalize(policy)&#xA;        Dim plA As String = Normalize(policies)&#xA;&#xA;        If pnA.Length = 0 OrElse plA.Length = 0 Then Return 0&#xA;&#xA;        ' Exact match:&#xA;        If String.Equals(pnA, plA, StringComparison.Ordinal) Then&#xA;            Return 1&#xA;        End If&#xA;&#xA;        ' Contains match rule:&#xA;        ' - claim length &gt; 5&#xA;        ' - either contains the other&#xA;        ' - abs(length diff) &lt; 6&#xA;        ' This is to allow for small variations/typos in the policy number while avoiding too broad matches (e.g. &quot;123&quot; matching &quot;12345678901234567890&quot;)&#xA;        If pnA.Length &gt; 5 Then&#xA;            Dim containsEither As Boolean = plA.Contains(pnA) OrElse pnA.Contains(plA)&#xA;            Dim lenClose As Boolean = Math.Abs(pnA.Length - plA.Length) &lt; 6&#xA;            If containsEither AndAlso lenClose Then&#xA;                Return 2&#xA;            End If&#xA;        End If&#xA;&#xA;        Return 0&#xA;    End Function&#xA;&#xA;'---- Find best match ----&#xA;Dim policyAlpha As String = Normalize(in_PolicyNumber)&#xA;&#xA;Dim bestMatch As String = Nothing&#xA;Dim bestIndex As Int32 = -1&#xA;Dim bestType As Int32 = 0&#xA;Dim bestLenDiff As Int32 = Integer.MaxValue&#xA;&#xA;If policyList IsNot Nothing Then&#xA;    For i As Integer = 0 To policyList.Count - 1&#xA;        Dim policies As String = policyList(i)&#xA;        Dim candAlpha As String = Normalize(policies)&#xA;        Dim mType As Integer = GetMatchType(in_PolicyNumber, policies)&#xA;&#xA;        If mType &gt; 0 Then&#xA;            Dim diff As Integer = Math.Abs(policyAlpha.Length - candAlpha.Length)&#xA;&#xA;            ' Determine if this match is better than the best match found so far based on the match type and length difference.&#xA;            Dim isBetter As Boolean =&#xA;                (bestIndex = -1) OrElse&#xA;                (mType &lt; bestType) OrElse&#xA;                (mType = bestType AndAlso diff &lt; bestLenDiff)&#xA;&#xA;            If isBetter Then&#xA;                bestType = mType&#xA;                bestLenDiff = diff&#xA;                bestMatch = policies&#xA;                bestIndex = i&#xA;            End If&#xA;        End If&#xA;    Next&#xA;End If&#xA;&#xA;' ---- Set outputs ----&#xA;out_MatchType = bestType&#xA;out_AppropriatePolicyNumber = If(bestMatch Is Nothing, String.Empty, bestMatch)" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="484.8,200.8" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
